---
import { icons } from '../data/icons';

interface Props {
  name: string;
  size?: number;
}
const { name, size = 24 } = Astro.props;
const icon = icons[name];

// Monogram for tools without a published mark: "Random Forest" → RF, "PostGIS" → PG, "AWS" → AWS.
const words = name.split(/\s+/);
const caps = name.replace(/[^A-Z]/g, '');
const mono =
  words.length > 1
    ? words.map((w) => w[0].toUpperCase()).join('').slice(0, 2)
    : name === name.toUpperCase()
      ? name.slice(0, 3)
      : caps.length >= 2
        ? caps.slice(0, 2)
        : name.slice(0, 2);
---

{
  icon ? (
    <svg
      class="ti"
      width={size}
      height={size}
      viewBox="0 0 24 24"
      role="img"
      aria-label={name}
      style={icon.hex ? `--brand:${icon.hex}` : undefined}
    >
      <path d={icon.path} fill="currentColor" />
    </svg>
  ) : (
    <span class="ti ti-mono" style={`--s:${size}px`} role="img" aria-label={name}>
      {mono}
    </span>
  )
}

<style>
  .ti {
    flex: none;
    color: var(--brand, var(--fg));
  }
  .ti-mono {
    display: grid;
    place-items: center;
    width: var(--s);
    height: var(--s);
    border-radius: 7px;
    border: 1px solid var(--accent);
    color: var(--accent);
    font: 600 calc(var(--s) * 0.38) / 1 var(--f-mono);
    letter-spacing: -0.02em;
  }
</style>
