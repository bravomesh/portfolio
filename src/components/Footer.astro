---
import Icon from './Icon.astro';
import { profile } from '../data/site';
---

<footer class="footer">
  <div class="container">
    <div class="row">
      <a href="#top" class="logo" aria-label="Back to top">MK<span>.</span></a>
      <a href="#top" class="top mono" data-magnetic>Back to top <Icon name="arrow" size={14} /></a>
    </div>
    <div class="row small mono">
      <span>© {new Date().getFullYear()} {profile.name}</span>
      <span>{profile.coords.lat.toFixed(4)}° · {profile.coords.lon.toFixed(4)}°</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding-block: 48px 32px;
    border-top: 1px solid var(--line);
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 32px;
  }
  .row + .row {
    margin-top: 40px;
  }
  .logo {
    font: 400 2.4rem/1 var(--f-display);
  }
  .logo span {
    color: var(--accent);
  }
  .top {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    border: 1px solid var(--line-2);
    border-radius: 999px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    transition: border-color 0.3s, color 0.3s;
  }
  .top:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .top :global(svg) {
    rotate: -45deg;
  }
  .small {
    color: var(--muted);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
  }
</style>
