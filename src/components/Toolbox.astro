---
import ToolIcon from './ToolIcon.astro';
import { toolbox } from '../data/site';
import { icons } from '../data/icons';

const pad = (n: number) => String(n).padStart(2, '0');
// Six pin slots per layer, nudged per layer so the stack doesn't look gridded.
const slots = [
  [24, 30], [52, 22], [78, 34],
  [30, 70], [58, 62], [80, 76],
];
---

<section class="section toolbox" id="toolbox">
  <div class="container">
    <header class="head">
      <span class="eyebrow" data-reveal>03 · Toolbox</span>
      <h2 class="h2" data-split>Satellites in, <em>decisions</em> out.</h2>
      <p class="lead" data-reveal>
        Four layers of the stack behind the platforms, from Earth-observation pipelines and models to the APIs,
        interfaces and infrastructure that serve them.
      </p>
    </header>
  </div>

  <div class="tb" data-tb>
    <div class="container stage">
      <div class="scene" aria-hidden="true">
        <span class="io in mono">▼ Satellite &amp; climate data in</span>
        <div class="stack" data-stack>
          {
            toolbox.map((t, i) => (
              <div class="plane" style={`--i:${i}`} data-plane>
                <span class="plane-label mono">
                  L{i + 1} · {t.short}
                </span>
                {t.items.slice(0, 6).map((name, j) => (
                  <span class="pin" data-tool={name} style={`--j:${j};--x:${slots[j][0] + ((i * 7) % 9) - 4}%;--y:${slots[j][1] + ((i * 5) % 7) - 3}%`}>
                    <span class="shadow" />
                    <span class="beam" />
                    <span class="bulb">
                      <ToolIcon name={name} size={20} />
                      <span class="tag mono">{name}</span>
                    </span>
                  </span>
                ))}
              </div>
            ))
          }
          <span class="spine"><i /></span>
        </div>
        <span class="io out mono">Decisions out ▼</span>
      </div>

      <div class="side">
        <nav class="steps mono" aria-label="Toolbox layers">
          {
            toolbox.map((t, i) => (
              <button type="button" class="step" data-step={i}>
                <span class="sn">{pad(i + 1)}</span>
                <span class="st">{t.short}</span>
                <i class="sbar" />
              </button>
            ))
          }
        </nav>
        <div class="panels">
          {
            toolbox.map((t, i) => (
              <article class="panel" data-panel>
                <p class="kicker mono">
                  L{i + 1} · {t.short}
                </p>
                <h3>{t.title}</h3>
                <p class="blurb">{t.blurb}</p>
                <ul class="tools">
                  {t.items.map((name, j) => (
                    <li data-tool={name} style={`--j:${j};--tile:${icons[name]?.hex ?? 'var(--accent)'}`}>
                      <ToolIcon name={name} size={26} />
                      <span>{name}</span>
                    </li>
                  ))}
                </ul>
              </article>
            ))
          }
        </div>
      </div>
    </div>
    <p class="cue mono" aria-hidden="true">Scroll to move through the layers <span>↓</span></p>
  </div>
</section>

<script>
  import { gsap, ScrollTrigger, lenis } from '../scripts/motion';

  const root = document.querySelector<HTMLElement>('[data-tb]')!;
  const stack = root.querySelector<HTMLElement>('[data-stack]')!;
  const planes = [...root.querySelectorAll<HTMLElement>('[data-plane]')];
  const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')];
  const steps = [...root.querySelectorAll<HTMLElement>('[data-step]')];

  let active = -1;
  const setActive = (i: number) => {
    if (i === active) return;
    active = i;
    planes.forEach((p, j) => {
      p.classList.toggle('active', j === i);
      p.classList.toggle('above', j < i); // layers above the active one peel away
    });
    panels.forEach((p, j) => p.classList.toggle('active', j === i));
    steps.forEach((s, j) => {
      s.classList.toggle('on', j === i);
      s.classList.toggle('done', j < i);
      s.setAttribute('aria-current', j === i ? 'step' : 'false');
    });
  };
  setActive(0);

  // Hovering a tile lights its pin on the 3D layer, and vice versa.
  const byTool = new Map<string, HTMLElement[]>();
  root.querySelectorAll<HTMLElement>('[data-tool]').forEach((el) => {
    const k = el.dataset.tool!;
    byTool.set(k, [...(byTool.get(k) ?? []), el]);
  });
  const light = (name: string, on: boolean) => {
    byTool.get(name)?.forEach((el) => el.classList.toggle('lit', on));
    stack.classList.toggle('has-lit', on);
  };
  root.querySelectorAll<HTMLElement>('.tools li, .pin').forEach((el) => {
    el.addEventListener('pointerenter', () => light(el.dataset.tool!, true));
    el.addEventListener('pointerleave', () => light(el.dataset.tool!, false));
  });

  // Tiles tilt toward the cursor with a brand-coloured glare.
  root.querySelectorAll<HTMLElement>('.tools li').forEach((li) => {
    li.addEventListener('pointermove', (e) => {
      if (e.pointerType !== 'mouse') return;
      const r = li.getBoundingClientRect();
      const px = (e.clientX - r.left) / r.width;
      const py = (e.clientY - r.top) / r.height;
      li.style.setProperty('--tx', `${(px - 0.5) * 16}deg`);
      li.style.setProperty('--ty', `${(0.5 - py) * 16}deg`);
      li.style.setProperty('--gx', `${px * 100}%`);
      li.style.setProperty('--gy', `${py * 100}%`);
    });
    li.addEventListener('pointerleave', () => {
      li.style.setProperty('--tx', '0deg');
      li.style.setProperty('--ty', '0deg');
    });
  });

  const mm = gsap.matchMedia();
  mm.add('(min-width: 901px) and (prefers-reduced-motion: no-preference)', () => {
    root.classList.add('is-pinned');
    const s = { gap: 14, rx: 64, rz: -48 };
    const tilt = { x: 0, y: 0 }; // mouse offset, -1..1
    const apply = () => {
      stack.style.setProperty('--gap', String(s.gap));
      stack.style.setProperty('--rx', `${s.rx - tilt.y * 7}deg`);
      stack.style.setProperty('--rz', `${s.rz + tilt.x * 10}deg`);
    };
    apply();
    const tx = gsap.quickTo(tilt, 'x', { duration: 1.4, ease: 'power3.out', onUpdate: apply });
    const ty = gsap.quickTo(tilt, 'y', { duration: 1.4, ease: 'power3.out', onUpdate: apply });
    const onMove = (e: PointerEvent) => {
      tx((e.clientX / innerWidth) * 2 - 1);
      ty((e.clientY / innerHeight) * 2 - 1);
    };
    const onLeave = () => {
      tx(0);
      ty(0);
    };
    root.addEventListener('pointermove', onMove);
    root.addEventListener('pointerleave', onLeave);
    const n = planes.length;
    const tl = gsap
      .timeline({
        defaults: { onUpdate: apply },
        scrollTrigger: {
          trigger: root,
          start: 'top top',
          end: `+=${planes.length * 85}%`,
          pin: true,
          scrub: 1,
          refreshPriority: 1,
          onUpdate: (self) => {
            const p = self.progress * n;
            const i = Math.min(n - 1, Math.floor(p));
            setActive(i);
            // Each step's bar fills as you scroll through that layer.
            steps.forEach((st, j) => st.style.setProperty('--p', j < i ? '1' : j > i ? '0' : String(Math.min(1, p - i))));
            root.classList.toggle('moved', self.progress > 0.1);
          },
        },
      })
      .to(s, { gap: 88, rx: 56, rz: -38, duration: 0.3, ease: 'power2.out' })
      .to(s, { rz: -28, duration: 0.7, ease: 'none' });
    ScrollTrigger.sort();

    // Click a step to glide to the middle of that layer.
    const onStep = (e: Event) => {
      const st = tl.scrollTrigger!;
      const i = Number((e.currentTarget as HTMLElement).dataset.step);
      const y = st.start + (st.end - st.start) * ((i + 0.5) / n);
      if (lenis) lenis.scrollTo(y, { duration: 1.2 });
      else scrollTo({ top: y, behavior: 'smooth' });
    };
    steps.forEach((b) => b.addEventListener('click', onStep));

    return () => {
      root.removeEventListener('pointermove', onMove);
      root.removeEventListener('pointerleave', onLeave);
      steps.forEach((b) => b.removeEventListener('click', onStep));
      root.classList.remove('is-pinned', 'moved');
      stack.style.removeProperty('--gap');
      stack.style.removeProperty('--rx');
      stack.style.removeProperty('--rz');
    };
  });
</script>

<style>
  @property --lift {
    syntax: '<length>';
    inherits: false;
    initial-value: 0px;
  }

  .head {
    max-width: 860px;
  }

  .tb {
    margin-top: clamp(32px, 5vw, 64px);
  }
  .stage {
    display: grid;
    gap: 40px;
  }

  /* ---------- 3D layer stack ---------- */
  .scene {
    position: relative;
    display: grid;
    place-items: center;
    height: 440px;
    perspective: 2000px;
    overflow-x: clip;
  }
  .io {
    position: absolute;
    left: 50%;
    translate: -50% 0;
    font-size: 0.66rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    white-space: nowrap;
  }
  .io.in {
    top: 0;
    color: var(--accent);
  }
  .io.out {
    bottom: 0;
  }
  .stack {
    --gap: 70;
    --rx: 56deg;
    --rz: -36deg;
    position: relative;
    width: min(54vw, 270px);
    aspect-ratio: 1;
    transform-style: preserve-3d;
    transform: rotateX(var(--rx)) rotateZ(var(--rz));
  }
  .plane {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    transform: translateZ(calc((1.5 - var(--i)) * var(--gap) * 1px + var(--lift)));
    border: 1px solid var(--line-2);
    border-radius: 18px;
    background:
      repeating-linear-gradient(0deg, transparent 0 calc(16.66% - 1px), var(--line) calc(16.66% - 1px) 16.66%),
      repeating-linear-gradient(90deg, transparent 0 calc(16.66% - 1px), var(--line) calc(16.66% - 1px) 16.66%),
      color-mix(in srgb, var(--bg-2) 88%, transparent);
    transition:
      --lift 0.8s var(--ease-out),
      border-color 0.5s,
      box-shadow 0.6s,
      opacity 0.5s;
  }
  .is-pinned .plane:not(.active) {
    opacity: 0.5;
  }
  .is-pinned .plane.above {
    --lift: 80px;
    opacity: 0.1;
  }
  /* Only the active layer carries logos; the others are clean outlines with their label */
  .pin {
    transition: opacity 0.35s;
  }
  .is-pinned .plane:not(.active) .pin {
    opacity: 0;
    pointer-events: none;
  }
  .is-pinned .plane:not(.active) .bulb {
    scale: 0.3;
  }
  .is-pinned .plane.active .pin {
    transition-delay: calc(0.12s + var(--j) * 0.06s);
  }
  .is-pinned .plane.active .bulb {
    transition-delay: calc(0.12s + var(--j) * 0.06s), calc(0.12s + var(--j) * 0.06s), 0s, 0s;
  }
  .is-pinned .plane.active .pin.lit .bulb {
    transition-delay: 0s; /* hover feedback is instant */
  }
  .plane.active {
    --lift: 34px;
    border-color: var(--accent);
    box-shadow:
      0 0 0 1px var(--accent),
      0 0 80px -10px var(--accent-soft),
      inset 0 0 60px -20px var(--accent-soft);
  }
  .plane-label {
    position: absolute;
    left: 14px;
    bottom: 10px;
    font-size: 0.6rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    white-space: nowrap;
  }
  .plane.active .plane-label {
    color: var(--accent);
  }

  /* Logo pins stand up from the plane, always facing the viewer */
  .pin {
    position: absolute;
    left: var(--x);
    top: var(--y);
    transform-style: preserve-3d;
  }
  .shadow {
    position: absolute;
    left: -9px;
    top: -9px;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, var(--fg) 30%, transparent), transparent 70%);
  }
  .bulb {
    position: absolute;
    left: -18px;
    top: -36px;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--bg);
    border: 1px solid var(--line-2);
    transform-origin: 50% 100%;
    transform: translateZ(14px) rotateZ(calc(-1 * var(--rz))) rotateX(calc(-1 * var(--rx)));
    transition:
      border-color 0.5s,
      scale 0.6s var(--ease-out),
      box-shadow 0.5s,
      opacity 0.4s;
  }
  .tag {
    position: absolute;
    bottom: calc(100% + 8px);
    left: 50%;
    translate: -50% 4px;
    padding: 4px 8px;
    border-radius: 6px;
    background: var(--fg);
    color: var(--bg);
    font-size: 0.6rem;
    letter-spacing: 0.06em;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s, translate 0.4s var(--ease-out);
  }
  /* A light column rising out of the plane at the pin */
  .beam {
    position: absolute;
    left: -1px;
    bottom: 0;
    width: 2px;
    height: 150px;
    transform-origin: 50% 100%;
    transform: rotateX(-90deg) scaleY(0);
    background: linear-gradient(to top, var(--accent), transparent);
    opacity: 0;
    transition: transform 0.6s var(--ease-out), opacity 0.4s;
    pointer-events: none;
  }
  .plane.active .bulb {
    border-color: var(--accent);
    scale: 1.12;
  }

  .bulb {
    cursor: default;
  }
  .stack.has-lit .pin:not(.lit) .bulb {
    opacity: 0.45;
  }
  .pin.lit .bulb {
    scale: 1.4;
    border-color: var(--accent);
    box-shadow:
      0 0 0 4px var(--accent-soft),
      0 0 26px var(--accent);
    z-index: 2;
  }
  .pin.lit .tag {
    opacity: 1;
    translate: -50% 0;
  }
  .pin.lit .beam {
    opacity: 1;
    transform: rotateX(-90deg) scaleY(1);
  }
  .pin.lit .shadow {
    background: none;
    border: 1px solid var(--accent);
    animation: ripple 1.4s var(--ease-out) infinite;
  }
  @keyframes ripple {
    from {
      scale: 0.6;
      opacity: 1;
    }
    to {
      scale: 3.2;
      opacity: 0;
    }
  }

  /* Data flow: one dashed spine through the stack with a soft pulse travelling down it */
  .spine {
    position: absolute;
    left: 50%;
    bottom: 50%;
    width: 1px;
    height: calc(3 * var(--gap) * 1px + 120px);
    transform-origin: 50% 100%;
    transform: translateZ(calc(-1.5 * var(--gap) * 1px)) rotateX(-90deg);
    background: repeating-linear-gradient(to top, var(--line-2) 0 5px, transparent 5px 11px);
    pointer-events: none;
  }
  .spine i {
    position: absolute;
    left: -1px;
    top: 0;
    width: 3px;
    height: 34px;
    border-radius: 2px;
    background: linear-gradient(to bottom, transparent, var(--accent));
    box-shadow: 0 0 10px var(--accent-soft);
    animation: travel 3.4s cubic-bezier(0.45, 0, 0.55, 1) infinite;
  }
  @keyframes travel {
    0% {
      top: 0%;
      opacity: 0;
    }
    15%,
    80% {
      opacity: 0.9;
    }
    100% {
      top: 92%;
      opacity: 0;
    }
  }

  /* ---------- side panel ---------- */
  .steps,
  .cue {
    display: none;
  }
  .panels {
    display: grid;
    gap: 56px;
  }
  .kicker {
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.14em;
  }
  .panel h3 {
    margin-top: 12px;
    font: 400 clamp(2rem, 3.4vw, 3.1rem) / 1 var(--f-display);
    letter-spacing: -0.015em;
  }
  .blurb {
    margin-top: 12px;
    color: var(--muted);
  }
  .tools {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(118px, 1fr));
    gap: 10px;
    margin: 26px 0 0;
    padding: 0;
    list-style: none;
  }
  .tools li {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 16px 14px 14px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--bg-2);
    font: 500 0.74rem/1.25 var(--f-mono);
    color: var(--muted);
    overflow: hidden;
    transform: perspective(520px) rotateX(var(--ty, 0deg)) rotateY(var(--tx, 0deg));
    transition:
      border-color 0.4s,
      color 0.4s,
      translate 0.5s var(--ease-out),
      transform 0.5s var(--ease-out),
      box-shadow 0.5s;
  }
  .tools li.lit {
    border-color: color-mix(in srgb, var(--tile) 70%, transparent);
    color: var(--fg);
  }
  .tools li.lit::before {
    opacity: 1;
  }
  .tools li::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at var(--gx, 20%) var(--gy, 0%), color-mix(in srgb, var(--tile, var(--accent)) 26%, transparent), transparent 70%);
    opacity: 0;
    transition: opacity 0.4s;
  }
  .tools li:hover {
    translate: 0 -4px;
    color: var(--fg);
    border-color: var(--line-2);
    box-shadow: 0 18px 30px -22px rgba(0, 0, 0, 0.6);
  }
  .tools li:hover::before {
    opacity: 1;
  }
  .tools li:hover :global(.ti) {
    scale: 1.12;
  }
  .tools li :global(.ti) {
    transition: scale 0.5s var(--ease-out);
  }

  /* ---------- pinned (desktop, motion OK) ---------- */
  .is-pinned {
    position: relative;
    height: 100vh;
    display: flex;
    align-items: center;
    margin-top: 0;
  }
  .is-pinned .stage {
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    align-items: center;
    gap: clamp(32px, 5vw, 80px);
  }
  .is-pinned .scene {
    height: min(78vh, 680px);
  }
  .is-pinned .stack {
    width: min(30vw, 380px);
  }
  /* Named, clickable steps with a bar that fills through each layer */
  .is-pinned .steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
    margin-bottom: 30px;
  }
  .step {
    display: grid;
    gap: 6px;
    align-content: start;
    padding: 0 0 10px;
    text-align: left;
    color: var(--muted);
    font: inherit;
    font-size: 0.64rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    line-height: 1.3;
    transition: color 0.3s;
  }
  .step:hover,
  .step.on {
    color: var(--fg);
  }
  .sn {
    color: var(--accent);
    opacity: 0.6;
  }
  .step.on .sn {
    opacity: 1;
  }
  .sbar {
    position: relative;
    height: 2px;
    margin-top: 4px;
    background: var(--line-2);
    overflow: hidden;
  }
  .sbar::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--accent);
    transform: scaleX(var(--p, 0));
    transform-origin: left;
  }
  .step.done .sbar::after {
    opacity: 0.55;
  }

  /* Scroll cue, shown until you start moving through the layers */
  .is-pinned .cue {
    display: flex;
    position: absolute;
    left: 50%;
    bottom: 26px;
    translate: -50% 0;
    align-items: center;
    gap: 10px;
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    transition: opacity 0.5s, translate 0.6s var(--ease-out);
  }
  .cue span {
    color: var(--accent);
    animation: bob 1.6s var(--ease-out) infinite;
  }
  @keyframes bob {
    50% {
      translate: 0 4px;
    }
  }
  .is-pinned.moved .cue {
    opacity: 0;
    translate: -50% 10px;
  }
  .is-pinned .panels {
    display: grid;
    gap: 0;
  }
  .is-pinned .panel {
    grid-area: 1 / 1;
    pointer-events: none;
  }
  .is-pinned .panel.active {
    pointer-events: auto;
  }
  .is-pinned .panel > :not(.tools),
  .is-pinned .tools li {
    opacity: 0;
    translate: 0 18px;
    transition:
      opacity 0.35s,
      translate 0.6s var(--ease-out),
      transform 0.5s var(--ease-out),
      border-color 0.4s,
      color 0.4s,
      box-shadow 0.5s;
  }
  .is-pinned .panel.active > :not(.tools),
  .is-pinned .panel.active .tools li {
    opacity: 1;
    translate: 0;
    transition-delay: 0.08s;
  }
  .is-pinned .panel.active .tools li {
    transition-delay: calc(0.15s + var(--j) * 0.035s);
  }
  .is-pinned .panel.active .tools li:hover {
    translate: 0 -4px;
    transition-delay: 0s;
  }
</style>
