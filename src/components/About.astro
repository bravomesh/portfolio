---
import { Image } from 'astro:assets';
import photo from '../assets/meshack.jpeg';
import { about, path, profile } from '../data/site';
---

<section class="section about" id="about">
  <div class="container">
    <div class="grid">
      <figure class="photo">
        <div class="frame" data-photo data-tilt>
          <Image
            src={photo}
            alt={`${profile.name} at the IGAD offices`}
            widths={[420, 640, 900]}
            sizes="(max-width: 900px) 90vw, 36vw"
            loading="lazy"
          />
        </div>
        <figcaption class="mono">
          <span>{profile.location}</span>
          <span>1.29°S · 36.82°E</span>
        </figcaption>
      </figure>

      <div class="copy">
        <span class="eyebrow" data-reveal>01 · About</span>
        <h2 class="h2" data-split>From code to <em>coordinates</em>.</h2>
        <div class="text" data-stagger>
          {about.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </div>

    <ol class="path" data-path>
      <span class="rail" aria-hidden="true"><i></i></span>
      {
        path.map((s) => (
          <li>
            <span class="dot" aria-hidden="true" />
            <span class="step mono">{s.step}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<script>
  import { gsap, reduced } from '../scripts/motion';

  if (!reduced) {
    const frame = document.querySelector('[data-photo]')!;
    gsap.fromTo(
      frame,
      { clipPath: 'inset(100% 0% 0% 0%)' },
      {
        clipPath: 'inset(0% 0% 0% 0%)',
        duration: 1.6,
        ease: 'expo.inOut',
        scrollTrigger: { trigger: frame, start: 'top 80%', once: true },
      },
    );
    gsap.fromTo(
      frame.querySelector('img'),
      { scale: 1.25, yPercent: -6 },
      { scale: 1.05, yPercent: 6, ease: 'none', scrollTrigger: { trigger: frame, start: 'top bottom', end: 'bottom top', scrub: true } },
    );

    const pathEl = document.querySelector('[data-path]')!;
    gsap.fromTo(pathEl.querySelector('.rail i'), { '--p': 0 }, {
      '--p': 1,
      ease: 'none',
      scrollTrigger: { trigger: pathEl, start: 'top 85%', end: 'bottom 60%', scrub: true },
    });
    gsap.from(pathEl.querySelectorAll('li'), {
      y: 40,
      opacity: 0,
      stagger: 0.15,
      duration: 1.1,
      ease: 'expo.out',
      scrollTrigger: { trigger: pathEl, start: 'top 85%', once: true },
    });
  }
</script>

<style>
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr);
    gap: clamp(40px, 7vw, 120px);
    align-items: center;
  }
  .photo {
    margin: 0;
  }
  .frame {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: 24px;
    overflow: hidden;
    background: var(--bg-3);
  }
  .frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 22%;
  }
  .frame::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 60%, color-mix(in srgb, var(--bg) 50%, transparent));
  }
  figcaption {
    display: flex;
    justify-content: space-between;
    margin-top: 14px;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }
  .text {
    display: grid;
    gap: 18px;
    margin-top: 32px;
    max-width: 58ch;
    color: var(--muted);
    font-size: clamp(1rem, 1.25vw, 1.1rem);
  }
  .text p:first-child {
    color: var(--fg);
    font: 400 clamp(1.4rem, 2.2vw, 1.8rem) / 1.3 var(--f-display);
  }

  .path {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(24px, 4vw, 64px);
    margin: clamp(80px, 10vw, 140px) 0 0;
    padding: 0;
    list-style: none;
  }
  .rail {
    position: absolute;
    top: 6px;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--line);
  }
  .rail i {
    display: block;
    height: 100%;
    background: var(--accent);
    transform: scaleX(var(--p, 1));
    transform-origin: left;
  }
  .path li {
    position: relative;
    padding-top: 40px;
  }
  .dot {
    position: absolute;
    top: 0;
    left: 0;
    width: 13px;
    height: 13px;
    border-radius: 50%;
    background: var(--bg);
    border: 1px solid var(--accent);
  }
  .dot::after {
    content: '';
    position: absolute;
    inset: 3px;
    border-radius: 50%;
    background: var(--accent);
  }
  .step {
    color: var(--accent);
  }
  .path h3 {
    margin-top: 10px;
    font: 400 clamp(1.8rem, 2.6vw, 2.4rem) / 1.05 var(--f-display);
  }
  .path p {
    margin-top: 12px;
    color: var(--muted);
    max-width: 38ch;
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .photo {
      max-width: 460px;
    }
    .path {
      grid-template-columns: 1fr;
      padding-left: 32px;
    }
    .rail {
      top: 0;
      bottom: 0;
      left: 6px;
      right: auto;
      width: 1px;
      height: auto;
    }
    .rail i {
      height: 100%;
      transform: scaleY(var(--p, 1));
      transform-origin: top;
    }
    .path li {
      padding-top: 0;
    }
    .dot {
      left: -32px;
      top: 6px;
    }
  }
</style>
