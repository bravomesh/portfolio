---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Platforms from '../components/Platforms.astro';
---

<Base>
  <Nav />
  <main id="main">
    <Hero />
    <Platforms />
    {['about', 'toolbox', 'experience', 'work', 'contact'].map((id) => (
      <section id={id} class="section container" style="min-height:80vh"><span class="eyebrow">{id}</span><h2 class="h2" data-split>Placeholder heading for <em>{id}</em> section</h2></section>
    ))}
  </main>
</Base>
