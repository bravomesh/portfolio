---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
---

<Base>
  <Nav />
  <main id="main">
    <section id="top" class="section container"><h1 class="h2">Meshack <em>Kibet</em></h1></section>
    {['about', 'platforms', 'toolbox', 'experience', 'work', 'contact'].map((id) => (
      <section id={id} class="section container" style="min-height:80vh"><span class="eyebrow">{id}</span></section>
    ))}
  </main>
</Base>
